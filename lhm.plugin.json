    {
      "name": "scale_ingredients",
      "title": "Scale a list of ingredients",
      "description": "Put a list of ingredient lines to a different number of people. Pass 'factor', or else the pair 'from_servings' and 'to_servings'. Quantities are recomputed by this server and not by the site, and every line says under 'scaling' whether the arithmetic landed exactly, whether the figure was moved to stay usable in a kitchen, or whether the line carried nothing to multiply.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "ingredients": {
            "minItems": 1,
            "maxItems": 100,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 300
            },
            "description": "The lines to scale, as a recipe writes them, such as '200g plain flour'."
          },
          "factor": {
            "description": "What to multiply every quantity by. Pass this or the servings pair, never both.",
            "type": "number",
            "minimum": 0.001,
            "maximum": 1000
          },
          "from_servings": {
            "description": "How many people the list feeds as written.",
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "to_servings": {
            "description": "How many people it should feed.",
